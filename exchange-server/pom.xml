<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ru.lab.concurrent</groupId>
    <artifactId>exchange-lab</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>exchange-server</artifactId>
  <name>exchange-lab :: биржа (Spring Boot сервис)</name>

  <dependencies>
    <dependency>
      <groupId>ru.lab.concurrent</groupId>
      <artifactId>exchange-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>ru.lab.concurrent.server.ExchangeLabApplication</mainClass>
          <!-- exec-классификатор: обычный jar остаётся «тонким», чтобы lab-harness мог
               поднять биржу в своей JVM как зависимость, а не как fat-jar -->
          <classifier>exec</classifier>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
