* text=auto

# исходники и документы — LF в репозитории, чтобы диффы не шумели
*.java text eol=lf
*.xml  text eol=lf
*.yml  text eol=lf
*.md   text eol=lf

# Windows-скрипты аудитории — обязательно CRLF, иначе cmd.exe их не запускает
*.cmd  text eol=crlf
*.bat  text eol=crlf

# артефакты прогонов (если кто-то всё же приложит к отчёту)
*.csv  text eol=lf
*.log  -text
